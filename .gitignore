*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.conda/

