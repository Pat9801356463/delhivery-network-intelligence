!data/sample/

# ── Model artefacts (large binaries) ─────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
# Keep model directory structure
!models/.gitkeep

# ── Feature store (very large) ────────────────────────────────
outputs/feature_store.pkl
outputs/*_clean*.csv
outputs/train_*.csv
outputs/test_*.csv

# ── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

